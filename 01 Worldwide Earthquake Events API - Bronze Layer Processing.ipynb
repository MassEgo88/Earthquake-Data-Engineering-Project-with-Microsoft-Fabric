import os
import json
import logging
import requests
from requests.adapters import HTTPAdapter
from urllib3.util import Retry
from notebookutils import mssparkutils  # Native Fabric environment utility

# Configure structured logging for Fabric monitoring logs
logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
logger = logging.getLogger(__name__)

# --- PARAMETERS (Fabric Data Factory Injected Variables) ---
# Default fallbacks allow debugging the notebook standalone without triggering pipeline errors
start_date = globals().get("start_date", "2026-01-01")
end_date = globals().get("end_date", "2026-01-02")

def create_retry_session(retries=3, backoff_factor=1.0, status_forcelist=(429, 500, 502, 503, 504)):
    """Creates a resilient network session utilizing exponential backoff for API throttling."""
    session = requests.Session()
    retry = Retry(
        total=retries,
        read=retries,
        connect=retries,
        backoff_factor=backoff_factor,
        status_forcelist=status_forcelist,
        raise_on_status=False
    )
    adapter = HTTPAdapter(max_retries=retry)
    session.mount("http://", adapter)
    session.mount("https://", adapter)
    return session

def fetch_and_stage_earthquake_data():
    # 1. Dynamically identify Lakehouse path (Prevents hardcoding errors across Dev/Prod environments)
    try:
        lakehouse_dir = mssparkutils.fs.getWorkspaceId() # Verifies Fabric context
        base_path = f"/lakehouse/default/Files/bronze/earthquakes"
        os.makedirs(base_path, exist_ok=True)
        file_path = f"{base_path}/{start_date}_earthquake_data.json"
    except Exception as e:
        logger.error(f"Failed to resolve Fabric Lakehouse file directory structures: {e}")
        raise

    # 2. Configure resilient USGS API payload structure
    url = "https://earthquake.usgs.gov/fdsnws/event/1/query"
    params = {
        "format": "geojson",
        "starttime": start_date,
        "endtime": end_date
    }

    logger.info(f"Initiating ingestion for range: {start_date} to {end_date}")

    # 3. Execute request within network context manager
    with create_retry_session() as session:
        try:
            response = session.get(url, params=params, timeout=(5, 30)) # 5s connect timeout, 30s read timeout
            response.raise_for_status() # Automatically throws HTTPError for 4xx/5xx responses
            
            payload = response.json()
            features = payload.get("features", [])

            # Check if API returned an empty list for that specific day range
            if not features:
                logger.warning(f"No earthquake events recorded by USGS between {start_date} and {end_date}.")
                return

            # 4. Stream payload to Lakehouse storage
            with open(file_path, "w", encoding="utf-8") as file:
                json.dump(features, file, ensure_ascii=False, indent=4)
                
            logger.info(f"Ingestion successful. {len(features)} events stored safely at: {file_path}")

        except requests.exceptions.HTTPError as http_err:
            logger.error(f"USGS API responded with HTTP Error: {http_err} | Response Content: {response.text}")
            raise
        except requests.exceptions.RequestException as req_err:
            logger.error(f"Network transport infrastructure failure encountered: {req_err}")
            raise
        except (json.JSONDecodeError, KeyError) as parse_err:
            logger.error(f"API Payload structure payload validation failed: {parse_err}")
            raise
        except Exception as general_err:
            logger.error(f"Unexpected operational anomaly occurred during pipeline step: {general_err}")
            raise

if __name__ == "__main__":
    fetch_and_stage_earthquake_data()

